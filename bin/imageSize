#!/bin/bash

: ${IMAGESIZE_SEPARATOR:=$'\t'}

getShortUsage()
{
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|choose)
		printf %s "${usageSep}${hadTopic:+ }" '--smallest|--largest|--min|--max|--min-width|--max-width|--min-height|--max-height|--min-both|--max-both'; hadTopic=t;;&
	    ''|compare)
		printf %s "${usageSep}${hadTopic:+ }" '-g|--greater|-s|--smaller|-lt|-le|-eq|-ne|-ge|-gt SIZE|WxH'; hadTopic=t;;&
	    ''|compare-options)
		printf %s "${usageSep}${hadTopic:+ }" '[-A|--always-output|-S|--success-output]'; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    ''|choose)
		cat <<HELPTEXT
    --smallest		Print the dimensions of the smallest image (by area).
    --largest		Print the dimensions of the largest image (by area).
    --min		Print the dimensions of the image with the smallest sum
			of width and height.
    --max		Print the dimensions of the image with the largest sum
			of width and height.
    --min-width		Print the dimensions of the image with the smallest
			width.
    --max-width		Print the dimensions of the image with the largest
			width.
    --min-height	Print the dimensions of the image with the smallest
			height.
    --max-height	Print the dimensions of the image with the largest
			height.
    --min-both		Print the smallest width and height (not necessarily
			from the same image).
    --max-both		Print the largest width and height (not necessarily
			from the same image).
HELPTEXT
		hadTopic=t
		;;&
	    ''|compare-options)
		cat <<HELPTEXT
    --always-output|-A	Normally, when a comparison is made and succeeds, the
			dimensions are not printed; with this flag, they are
			always printed.
    --success-output|-S	Normally, when a comparison is made and succeeds, the
			dimensions are not printed; this flag inverts that, so
			IMAGE-FILEs that pass the comparison have the dimensions
			printed, and those that don't are suppressed.
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}

printUsage()
{
    cat <<HELPTEXT
Show the image width and height (tab-separated) (or relative to DIFF-FILE) of
all passed IMAGE-FILE(s) (with appended filespec if multiple are given).
HELPTEXT
    echo
    printf "Usage: [IMAGESIZE_SEPARATOR=\$'\\\\t'] %q %s\\n" "$(basename "$1")" '[-d|--diff DIFF-FILE] [--] IMAGE-FILE [...] [-?|-h|--help]'
    echo
    cat <<HELPTEXT
Print the image width and height (tab-separated) of that IMAGE-FILE that
fulfills the passed condition:
HELPTEXT
    getLongUsage choose
    cat <<HELPTEXT
    --with-filename|-f	Append a tab and the filespec(s) of all IMAGE-FILEs that
			fulfill the condition.
HELPTEXT
    echo
    printf "Usage: [IMAGESIZE_SEPARATOR=\$'\\\\t'] %q %s\\n" "$(basename "$1")" "$(getShortUsage choose) [-f|--with-filename] [--] IMAGE-FILE IMAGE-FILE [...]"
    echo
    cat <<HELPTEXT
Test whether both width and height of [all] IMAGE-FILE[s] is greater / smaller
than SIZE|WxH.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "$(getShortUsage compare) [-f|--with-filename] $(getShortUsage compare-options) [--] IMAGE-FILE [...]"
    echo
    getLongUsage compare-options
    cat <<HELPTEXT
EXIT STATUS:
    0	Complete success.
    1	The comparison failed; at least one FILE did not pass it.
    2	Bad invocation, wrong or missing command-line arguments.
    4	Some of the passed FILE(s) do not exist.
HELPTEXT
}

getDimensions()
{
    local format; printf -v format "%%w%s%%h\\n" "${IMAGESIZE_SEPARATOR:?}"
    [ "$isIncludeFilespec" -o $# -gt 1 ] && format="${format%$'\n'}"$'\t%f\n'

    eval "$(${TEST:+testeval --for identify --} "${TEST:-printf}" "${TEST:- %q}" identify -ping -format "$format" -- "$@")" || return 4
}

parseDimensions()
{
    if [[ "${1:?}" =~ ^([[:digit:]]+)x([[:digit:]]+)$ ]]; then
	width=${BASH_REMATCH[1]}
	height=${BASH_REMATCH[2]}
    elif [[ "$1" =~ ^[[:digit:]]+$ ]]; then
	height=$1
	width=$1
    else
	echo "ERROR: Invalid SIZE|WxH: $1"
	echo
	printUsage "$0"
	exit 2
    fi >&2
}

diffHeight=
diffWidth=
typeset -a selectors=()
chooseOp=
isIncludeFilespec=
compareOp=
compareConjunction=-a
isAlwaysOutput=
isSuccessOutput=
option() { :; }
parameter() { :; }
parameterToSep() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { argCount "$@"; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--diff|-d)	parameter diff; shift; { IFS=$'\t' read -r diffWidth diffHeight || { exit $diffHeight; }; } < <(IMAGESIZE_SEPARATOR=$'\t' isIncludeFilespec='' getDimensions "$1"); shift;;

	--smallest)	shift; selectors=('fileWidth * fileHeight');	chooseOp=-lt; option choose;;
	--largest)	shift; selectors=('fileWidth * fileHeight');	chooseOp=-gt; option choose;;
	--min)		shift; selectors=('fileWidth + fileHeight');	chooseOp=-lt; option choose;;
	--max)		shift; selectors=('fileWidth + fileHeight');	chooseOp=-gt; option choose;;
	--min-width)	shift; selectors=('fileWidth');			chooseOp=-lt; option choose;;
	--max-width)	shift; selectors=('fileWidth');			chooseOp=-gt; option choose;;
	--min-height)	shift; selectors=('fileHeight');		chooseOp=-lt; option choose;;
	--max-height)	shift; selectors=('fileHeight');		chooseOp=-gt; option choose;;
	--min-both)	shift; selectors=('fileWidth' 'fileHeight');	chooseOp=-lt; option choose;;
	--max-both)	shift; selectors=('fileWidth' 'fileHeight');	chooseOp=-gt; option choose;;

	--greater|-g)	shift; parseDimensions "$1"; shift; compareOp=-gt; parameter compare;;
	--smaller|-s)	shift; parseDimensions "$1"; shift; compareOp=-lt; parameter compare;;

	-ne)		compareConjunction=-o;;&
	-lt|-le|-eq|-ne|-ge|-gt)
			compareOp="$1"; shift; parseDimensions "$1"; shift; parameter compare;;

	--with-filename|-f)
			shift; isIncludeFilespec=t; option general;;
	--always-output|-A)
			shift; isAlwaysOutput=t; option compare-options;;
	--success-output|-S)
			shift; isSuccessOutput=t; option compare-options;;

	--)		endOfOptionsAndParameters; shift; break;;
	-*)		noUnderstand; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		endOfOptionsAndParameters; break;;
    esac
done
if [ $# -eq 0 ]; then
    printUsage "$0"
    exit 2
elif [ "$isAlwaysOutput" ] && [ "$isSuccessOutput" ]; then
    echo 'ERROR: Cannot combine -A|--always-output with -S|--success-output.'
    echo
    printUsage "$0"
    exit 2
fi >&2

typeset -a chosenResults0=()
typeset -A uniqueResults0=()
typeset -a chosenResults1=()
typeset -A uniqueResults1=()
clearResults()
{
    local -n chosenResultsRef="chosenResults${1:?}" uniqueResultsRef="uniqueResults${1:?}"; shift
    chosenResultsRef=()
    uniqueResultsRef=()
}
addUniqueResult()
{
    local -n chosenResultsRef="chosenResults${1:?}" uniqueResultsRef="uniqueResults${1:?}"; shift
    local width="${1:?}"; shift
    local height="${1:?}"; shift
    local filespec="${1?}"; shift

    [ "$isIncludeFilespec" ] || filespec=''
    printf -v result "%d${IMAGESIZE_SEPARATOR}%d${filespec:+\\t}%s" "$width" "$height" "$filespec"
    if [ ! "${uniqueResultsRef[$result]}" ]; then
	chosenResultsRef+=("$result")
	uniqueResultsRef["$result"]=t
    fi
}
printResults()
{
    case ${#selectors[@]} in
	0|1)
	    [ ${#chosenResults0[@]} -eq 0 ] \
		|| printf '%s\n' "${chosenResults0[@]}"
	    ;;
	2)  if [ "$isIncludeFilespec" ]; then
		# Take all results, but don't print duplicates if an IMAGE-FILE matches both
		# selectors.
		typeset -A seen=()
		for result in "${chosenResults0[@]}" "${chosenResults1[@]}"; do
		    if [ ! "${seen[$result]}" ]; then
			printf '%s\n' "$result"
			seen["$result"]=t
		    fi
		done
	    else
		# Each result column should have the same selected value; take the first result
		# from each column.
		printf '%d%s%d\n' "${chosenResults0[0]%%${IMAGESIZE_SEPARATOR}*}" "$IMAGESIZE_SEPARATOR" "${chosenResults1[0]#*${IMAGESIZE_SEPARATOR}}"
	    fi
	    ;;
	*)  printf >&2 'ASSERT: Unhanded number of selectors: %s\n' "${#selectors[@]}"; exit 3;;
	esac
}

if [ -n "$compareOp" ]; then
    exitStatus=3
    compareStatus=0
    while IFS=$'\t' read -r fileWidth fileHeight filespec || { exitStatus="$fileWidth"; break; }	# Exit status from the process substitution (<(getDimensions)) is lost; return the actual exit status via an incomplete (i.e. missing the newline) last line.
    do
	isChosen=; [ "$isAlwaysOutput" ] && isChosen=t
	if [ $fileWidth $compareOp $width $compareConjunction $fileHeight $compareOp $height ]; then
	    [ "$isSuccessOutput" ] && isChosen=t
	else
	    compareStatus=1
	    [ "$isSuccessOutput" ] || isChosen=t
	fi
	[ "$isChosen" ] && addUniqueResult 0 "$fileWidth" "$fileHeight" "$filespec"
    done < <(IMAGESIZE_SEPARATOR=$'\t' getDimensions "$@"; printf %d "$?")
    printResults
    exit $((exitStatus > 0 ? exitStatus : compareStatus))
elif [ -n "$diffWidth" -a -n "$diffHeight" ]; then
    exitStatus=3
    while IFS=$'\t' read -r fileWidth fileHeight filespec || { exitStatus="$fileWidth"; break; }	# Exit status from the process substitution (<(getDimensions)) is lost; return the actual exit status via an incomplete (i.e. missing the newline) last line.
    do
	printf "%d${IMAGESIZE_SEPARATOR}%d${filespec:+\\t}%s\\n" "$((fileWidth - diffWidth))" "$((fileHeight - diffHeight))" "$filespec"
    done < <(IMAGESIZE_SEPARATOR=$'\t' getDimensions "$@"; printf %d "$?")
    exit $exitStatus
elif [ ${#selectors[@]} -gt 0 ]; then
    exitStatus=3
    typeset -a chosenValues=()
    while IFS=$'\t' read -r fileWidth fileHeight filespec || { exitStatus="$fileWidth"; break; }	# Exit status from the process substitution (<(getDimensions)) is lost; return the actual exit status via an incomplete (i.e. missing the newline) last line.
    do
	for ((i = 0; i < ${#selectors[@]}; i++))
	do
	    selector="${selectors[i]}"
	    currentValue=$(($selector))
	    chosenValue="${chosenValues[i]}"
	    if [ -z "$chosenValue" ] || [ $currentValue $chooseOp $chosenValue ]; then
		chosenValues[i]=$currentValue
		clearResults $i
		addUniqueResult $i "$fileWidth" "$fileHeight" "$filespec"
	    elif [ $currentValue -eq $chosenValue ]; then
		addUniqueResult $i "$fileWidth" "$fileHeight" "$filespec"
	    fi
	done
    done < <(IMAGESIZE_SEPARATOR=$'\t' getDimensions "$@"; printf %d "$?")
    printResults
    exit $exitStatus
else
    getDimensions "$@"
fi
